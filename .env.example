# Buildy targetruntime — kopieer alleen naar een lokaal, niet-getrackt .env-bestand.
# Nooit echte secrets, persoonsgegevens, provider-URL's met tokens of signed URL's committen.

# Publieke frontendconfiguratie. Alleen VITE_* komt in de browserbundle.
VITE_SITE_URL="https://buildy.example"

# Omgeving en origins.
NODE_ENV="development"
APP_ENV="local" # local | test | preview | staging | production
APP_ORIGIN="http://127.0.0.1:8080"
# In productie exact dezelfde HTTPS-origin als APP_ORIGIN; geen pad of wildcard.
PRIMARY_DOMAIN=""
TRUSTED_ORIGINS=""

# Neon PostgreSQL. Gebruik een pooled URL voor de web-runtime. De schema-runner
# leest uitsluitend DATABASE_MIGRATION_URL; DATABASE_DIRECT_URL is apart voor
# gecontroleerde setup-, admin- en legacy-importtools. Iedere worker heeft een
# afzonderlijke login.
DATABASE_URL=""
DATABASE_MIGRATION_URL=""
DATABASE_DIRECT_URL=""
DATABASE_EMAIL_WORKER_URL=""
DATABASE_ACCOUNT_WORKER_URL=""
DATABASE_MEDIA_WORKER_URL=""
DATABASE_PHOTOBOOK_WORKER_URL=""
DATABASE_PAYMENT_WORKER_URL=""
DATABASE_FULFILMENT_WORKER_URL=""

# Door eigenaar/boekhouder/privacyreview goedgekeurd accountdeletebeleid.
# Laat beide leeg totdat versie en goedkeuringsdatum expliciet zijn vastgesteld;
# account lifecycle blijft dan fail-closed onbeschikbaar.
ACCOUNT_RETENTION_POLICY_VERSION=""
ACCOUNT_RETENTION_POLICY_APPROVED_AT=""

# Better Auth op Neon. Genereer secrets met een cryptografisch veilige generator.
BETTER_AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# PII envelope encryption. JSON-vorm: {"1":"<32-byte-base64-key>"}.
# Houd oude keyversies beschikbaar tot gecontroleerde rotatie is afgerond.
PII_ENCRYPTION_KEYS="{}"
PII_ENCRYPTION_CURRENT_VERSION="1"
PII_BLIND_INDEX_KEY=""

# Private Cloudflare R2-bucket; geen publieke bucket of permanente object-URL.
# Maak per boundary een apart, bucket-scoped least-privilege token en hergebruik
# nooit een workercredential voor webverkeer of een andere worker.
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_WEB_ACCESS_KEY_ID=""
R2_WEB_SECRET_ACCESS_KEY=""
R2_ACCOUNT_WORKER_ACCESS_KEY_ID=""
R2_ACCOUNT_WORKER_SECRET_ACCESS_KEY=""
R2_MEDIA_WORKER_ACCESS_KEY_ID=""
R2_MEDIA_WORKER_SECRET_ACCESS_KEY=""
R2_PHOTOBOOK_WORKER_ACCESS_KEY_ID=""
R2_PHOTOBOOK_WORKER_SECRET_ACCESS_KEY=""
R2_FULFILMENT_WORKER_ACCESS_KEY_ID=""
R2_FULFILMENT_WORKER_SECRET_ACCESS_KEY=""

# Brevo transactional e-mail. Templateconfig is environment-specifiek:
# Vereiste keys: auth.verify_email, auth.magic_link, auth.reset_password,
# lifecycle.welcome, social.access_requested, social.access_accepted,
# security.account_alert, order.confirmation, order.payment_failed,
# order.in_production, order.shipped, order.refund_review,
# support.confirmation, moderation.report_received en migration.account.
# Voorbeeld: {"lifecycle.welcome":{"id":0,"version":"content-v1"}, ...}
# Auth gebruikt de Brevo-template-ID. Voor repo-native account-, social-, order-
# en servicemails is het ID alleen een positief configuratie-/versieanker en
# wordt het niet naar Brevo gestuurd.
# Vervang 0 door een environment-specifiek positief ID; 0 wordt geweigerd.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Buildy"
BREVO_TEMPLATE_IDS="{}"
BREVO_WEBHOOK_SECRET=""

# Vercel verstuurt CRON_SECRET automatisch als Authorization: Bearer <secret>.
CRON_SECRET=""

# Stripe direct. Test- en livewaarden horen in gescheiden Vercel environments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_EXPECTED_ACCOUNT_ID=""
STRIPE_ENVIRONMENT="test" # test | live

# Goedgekeurde server-owned verkoopconfiguratie als strikte JSON. De prijsmatrix
# bevat environment, approvalStatus/ID/datum/vervaldatum en per land de ene
# launch-SKU met centbedragen, btwbehandeling en levertijd. Zonder formeel
# goedgekeurde matrix en juridische seller snapshot blijft checkout uit.
ORDER_PRICE_MATRIX_JSON=""
ORDER_SELLER_JSON=""
ORDER_TERMS_VERSION=""
# Providerconfiguratie kan gereed zijn terwijl checkout server-side dicht blijft.
CHECKOUT_ENABLED="false"
# Conservatieve default: alleen nieuwe accounts vereisen een invite. `false`
# opent publieke registratie en is nadrukkelijk geen noodstop.
BETA_MODE="true"

# Peecho REST v3. Sandbox en productie gebruiken gescheiden credentials/offering-ID's.
PEECHO_ENVIRONMENT="test" # test | live; bepaalt een hardcoded officiële base-URL
PEECHO_MERCHANT_API_KEY=""
PEECHO_SECRET_KEY=""
PEECHO_OFFERING_ID_A4_LANDSCAPE=""
PEECHO_TIMEOUT_MS="10000"
# Cloudflare R2 SigV4 ondersteunt maximaal 604800 seconden (7 dagen).
PEECHO_PDF_SIGNED_URL_TTL_SECONDS="604800"
PHOTOBOOK_MAX_PDF_BYTES="52428800"

# Retentie; juridisch en operationeel goedkeuren vóór productie.
PHOTOBOOK_ABANDONED_PDF_RETENTION_HOURS="48"
PHOTOBOOK_PAID_PDF_MAX_RETENTION_DAYS="90"
PHOTOBOOK_PDF_COMPLAINT_RETENTION_DAYS="30"

# Lokale server en buildhulpmiddelen.
BUILDY_API_HOST="127.0.0.1"
BUILDY_API_PORT="8787"
SITEMAP_SOURCE_URL=""
SITEMAP_SOURCE_TOKEN=""

# Legacymigratie. Scripts doen zonder expliciete run-gebonden gates geen
# netwerkread of providerwrite. Artifacts zijn versleuteld en gitignored.
LEGACY_DATABASE_URL=""
LEGACY_STORAGE_S3_ENDPOINT=""
LEGACY_STORAGE_REGION="eu-west-1"
LEGACY_STORAGE_ACCESS_KEY_ID=""
LEGACY_STORAGE_SECRET_ACCESS_KEY=""
R2_MIGRATION_ENDPOINT=""
# Tijdelijk, bucket-scoped cutovertoken. Nooit een runtime-/workerpaar hergebruiken.
R2_MIGRATION_ACCESS_KEY_ID=""
R2_MIGRATION_SECRET_ACCESS_KEY=""
MIGRATION_RUN_ID=""
MIGRATION_ARTIFACT_KEY="" # exact 32 random bytes, base64
MIGRATION_EXPECTED_SOURCE_HOST=""
MIGRATION_EXPECTED_STORAGE_SOURCE_HOST=""
MIGRATION_EXPECTED_TARGET_HOST=""
MIGRATION_EXPECTED_STORAGE_TARGET_HOST=""
MIGRATION_SOURCE_READ_CONFIRM="" # READ:<run-id>:<source-host>
MIGRATION_STORAGE_SOURCE_READ_CONFIRM="" # READ:<run-id>:<legacy-storage-host>
MIGRATION_TARGET_READ_CONFIRM="" # READ-TARGET:<run-id>:<target-host>
MIGRATION_WRITE_CONFIRM="" # APPLY:<run-id>:<environment>:<target-host>
MIGRATION_STORAGE_WRITE_CONFIRM="" # APPLY:<run-id>:<environment>:<r2-host>
MIGRATION_PRODUCTION_CONFIRM="" # PRODUCTION-CUTOVER:<run-id>:<target-host>
MIGRATION_STORAGE_PRODUCTION_CONFIRM="" # PRODUCTION-CUTOVER:<run-id>:<r2-host>
MIGRATION_BACKUP_ARTIFACT_SHA256=""
MIGRATION_ACCEPTANCE_ARTIFACT_SHA256=""
MIGRATION_ROLLBACK_WINDOW_ENDS_AT=""
