# Frontend (Vite). Alleen deze VITE_* waarden komen in de browserbundle.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SITE_URL="https://buildy.app"

# Alleen voor de oude Peecho Print Button-helper; niet gebruikt door de
# Buildy-owned Stripe-checkout.
VITE_PEECHO_SCRIPT_URL=""
VITE_PEECHO_BUTTON_KEY=""

# Supabase Edge Function secrets — nooit VITE_* maken.
# SUPABASE_URL, SUPABASE_ANON_KEY en SUPABASE_SERVICE_ROLE_KEY worden door
# Supabase zelf aan gedeployde functies aangeboden.
SITE_URL="https://buildy.app"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Door Sol/boekhouder goed te keuren verkoopconfiguratie. Bedragen zijn centen.
PHOTOBOOK_CURRENCY="eur"
PHOTOBOOK_BASE_PRICE_CENTS=""
PHOTOBOOK_PRICE_PER_PAGE_CENTS=""
PHOTOBOOK_SHIPPING_PRICE_CENTS=""
PHOTOBOOK_PRICES_INCLUDE_VAT="true"
PHOTOBOOK_DELIVERY_ESTIMATE=""
PHOTOBOOK_TERMS_VERSION=""
STRIPE_SHIPPING_COUNTRIES=""
# Alleen true maken nadat Stripe Tax volledig is geconfigureerd en getest.
STRIPE_AUTOMATIC_TAX="false"

# De juridische verkoper; exact gelijk houden aan site, Stripe en bevestiging.
SELLER_LEGAL_NAME=""
SELLER_CONTACT_EMAIL=""
SELLER_CONTACT_PHONE=""
SELLER_POSTAL_ADDRESS=""
SELLER_REGISTRATION_NUMBER=""

# Peecho fulfilment. Gebruik de testomgeving totdat één gecontroleerde order
# end-to-end is bewezen; productie accepteert alleen vertrouwde HTTPS-hosts.
PEECHO_ORDER_API_URL="https://test.www.peecho.com/rest/v3/order/"
PEECHO_PAYMENT_API_URL="https://test.www.peecho.com/rest/v3/order/payment"
PEECHO_MERCHANT_API_KEY=""
PEECHO_SECRET_KEY=""
PEECHO_OFFERING_ID_A4_LANDSCAPE=""
PEECHO_OFFERING_ID_A4_PORTRAIT=""
PEECHO_OFFERING_ID_SQUARE_210=""
PEECHO_PDF_SIGNED_URL_TTL_SECONDS="2592000"
PHOTOBOOK_MAX_PDF_BYTES="52428800"

# Retentie. Leg deze termijnen juridisch/operationeel vast vóór productie.
PHOTOBOOK_ABANDONED_PDF_RETENTION_HOURS="48"
PHOTOBOOK_PAID_PDF_MAX_RETENTION_DAYS="90"
PHOTOBOOK_PDF_COMPLAINT_RETENTION_DAYS="30"
PHOTOBOOK_RETENTION_CRON_SECRET=""

# AI-blauwdruk blijft een launch-NO-GO totdat leveranciers- en privacyafspraken
# aantoonbaar rond zijn.
VITE_AI_BLUEPRINT_ENABLED="false"
AI_BLUEPRINT_ENABLED="false"
AI_BLUEPRINT_DAILY_LIMIT="3"
LOVABLE_API_KEY=""

# Uitsluitend lokale checkoutontwikkeling op localhost; nooit in productie.
ALLOW_INSECURE_CHECKOUT_URLS="false"
