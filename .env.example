VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
VITE_SITE_URL="https://your-buildy-domain.nl"

# Optional override. Usually leave empty and use VITE_PEECHO_BUTTON_KEY.
VITE_PEECHO_SCRIPT_URL=""

VITE_PEECHO_BUTTON_KEY="YOUR_PEECHO_BUTTON_KEY"

# Server-side Supabase secrets for Buildy-owned checkout.
# Never expose these in VITE_* variables.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
SITE_URL="https://your-buildy-domain.nl"
PHOTOBOOK_CURRENCY="eur"
PHOTOBOOK_BASE_PRICE_CENTS="1295"
PHOTOBOOK_PRICE_PER_PAGE_CENTS="75"
STRIPE_SHIPPING_COUNTRIES="NL,BE,DE"

# Server-side Peecho fulfillment. Use test credentials until production is approved.
PEECHO_ORDER_API_URL="https://test.www.peecho.com/rest/v3/order/"
PEECHO_MERCHANT_API_KEY="YOUR_PEECHO_MERCHANT_API_KEY"
PEECHO_OFFERING_ID="YOUR_PEECHO_A4_LANDSCAPE_HARDCOVER_OFFERING_ID"
PEECHO_CONTENT_WIDTH_MM="297"
PEECHO_CONTENT_HEIGHT_MM="210"
