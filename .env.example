# Buildy active-runtime environment contract.
# Kopieer dit alleen naar een lokaal, niet-getrackt .env-bestand.
# Commit of log nooit secrets, tokens, volledige URLs met credentials of PII.

# Application and origin.
NODE_ENV="development" # development | test | production
APP_ENV="local" # local | test | preview | staging | production
APP_ORIGIN="http://127.0.0.1:8080"
PRIMARY_DOMAIN="" # production: exact dezelfde HTTPS-origin als APP_ORIGIN
TRUSTED_ORIGINS="" # kommagescheiden exacte origins; geen wildcards of paden
VITE_SITE_URL="http://127.0.0.1:8080"

# Server-owned product profile.
PRODUCT_PROFILE="feedback_beta"
BETA_MODE="true"
CHECKOUT_MODE="off" # local opt-in; Preview=test; production=live pas na alle gates

# Neon PostgreSQL. Gebruik afzonderlijke least-privilege rollen.
DATABASE_URL="" # pooled web-runtime-url
DATABASE_MIGRATION_URL="" # directe migrationrunner-url; nooit runtimefallback
DATABASE_DIRECT_URL="" # tijdelijke operator/bootstrap-url; niet voor de web-runtime
DATABASE_ACCOUNT_WORKER_URL=""
DATABASE_MEDIA_WORKER_URL=""
DATABASE_PHOTOBOOK_WORKER_URL=""
DATABASE_PAYMENT_WORKER_URL="" # alleen vereist wanneer checkout test/live is

# Data protection. Genereer unieke waarden per environment.
PII_ENCRYPTION_KEYS='{"1":"<32-byte-base64-key>"}'
PII_ENCRYPTION_CURRENT_VERSION="1"
PII_BLIND_INDEX_KEY=""

# Google OpenID Connect: de enige loginmethode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Private Vercel Blob and request-driven media/Bouwboek processing.
BLOB_READ_WRITE_TOKEN=""

# Alleen de dagelijkse account-lifecycle cron gebruikt dit secret.
CRON_SECRET="" # minimaal 32 tekens; nooit delen met providercredentials

# Account lifecycle requires an explicitly approved retention policy.
ACCOUNT_RETENTION_POLICY_VERSION=""
ACCOUNT_RETENTION_POLICY_APPROVED_AT="" # ISO-8601 met tijdzone

# Stripe Checkout. Laat leeg wanneer CHECKOUT_MODE=off.
STRIPE_ENVIRONMENT="" # test | live; moet exact overeenkomen met CHECKOUT_MODE
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_EXPECTED_ACCOUNT_ID=""
ORDER_PRICE_MATRIX_JSON="" # actuele, goedgekeurde versioned matrix; zie docs/STRIPE_SETUP.md
ORDER_SELLER_JSON="" # actuele, goedgekeurde seller-envelope; zie docs/STRIPE_SETUP.md
ORDER_TERMS_VERSION=""

# Alleen voor de lokale serveradapter.
BUILDY_API_HOST="127.0.0.1"
BUILDY_API_PORT="8787"

# Optionele build-time sitemapbron. Laat leeg voor alleen statische routes.
SITEMAP_SOURCE_URL=""
SITEMAP_SOURCE_TOKEN=""

# Alleen voor read-only launchbewijs; de SHA is altijd de volledige 40-teken git-SHA.
LAUNCH_BASE_URL=""
LAUNCH_EXPECTED_GIT_SHA=""

# Bewust afwezig: SESSION_SECRET (sessies zijn opaque en gehasht in Neon),
# Better Auth, password/magic-link/e-mailauth, Brevo/e-mailprovider,
# Cloudflare R2/AWS S3 en alle Peecho API/callback/worker/credentialvariabelen.
