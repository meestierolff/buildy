# Buildy gratis MVP-runtime.
# Kopieer naar een lokaal, niet-getrackt .env-bestand.
# Commit of log nooit secrets, tokens, credential-URL's of PII.

# Applicatie en exacte origins.
NODE_ENV="development" # development | test | production
APP_ENV="local" # local | test | preview | staging | production
APP_ORIGIN="http://127.0.0.1:8080"
PRIMARY_DOMAIN="" # production: exact dezelfde HTTPS-origin als APP_ORIGIN
TRUSTED_ORIGINS="" # kommagescheiden exacte origins; geen wildcards of paden
VITE_SITE_URL="http://127.0.0.1:8080"

# Server-owned productprofiel: open Google-signup, zonder betaalflow.
# Dit doel geldt lokaal, in Preview/staging en in Production.
# public_demo is een rollbackoptie, geen bewijs van een accountgebaseerde MVP.
PRODUCT_PROFILE="feedback_beta"
BETA_MODE="false"
CHECKOUT_MODE="off"

# Neon PostgreSQL. Gebruik per taak een afzonderlijke least-privilege rol.
DATABASE_URL="" # pooled web-runtime-url
DATABASE_MIGRATION_URL="" # directe migrator-url; nooit runtimefallback
DATABASE_DIRECT_URL="" # alleen voor gecontroleerde bootstrap/operatoracties
DATABASE_ACCOUNT_WORKER_URL=""
DATABASE_MEDIA_WORKER_URL=""

# Databescherming. Genereer unieke waarden per environment.
PII_ENCRYPTION_KEYS='{"1":"<32-byte-base64-key>"}'
PII_ENCRYPTION_CURRENT_VERSION="1"
PII_BLIND_INDEX_KEY=""

# Google OpenID Connect: de enige loginmethode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Private Vercel Blob voor uploads en het digitale Bouwboek.
BLOB_READ_WRITE_TOKEN=""

# Dormante commerceconfiguratie; buiten deze gratis MVP. Laat deze velden leeg.
# Het digitale Bouwboek vereist geen payment- of printproofworker.
# De bestaande betaalbeveiliging blijft behouden voor eventueel later gebruik.
DATABASE_PHOTOBOOK_WORKER_URL=""
DATABASE_PAYMENT_WORKER_URL=""
STRIPE_ENVIRONMENT="" # test | live; moet exact overeenkomen met CHECKOUT_MODE
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_EXPECTED_ACCOUNT_ID=""
ORDER_PRICE_MATRIX_JSON="" # strikte, actuele approval-envelope; geen voorbeeldprijs
ORDER_SELLER_JSON="" # strikte, actuele sellerapproval-envelope
ORDER_TERMS_VERSION=""

# De enige cron is de dagelijkse account-lifecyclecron.
CRON_SECRET="" # minimaal 32 tekens
ACCOUNT_RETENTION_POLICY_VERSION=""
ACCOUNT_RETENTION_POLICY_APPROVED_AT="" # ISO-8601 met tijdzone

# Alleen voor de lokale serveradapter.
BUILDY_API_HOST="127.0.0.1"
BUILDY_API_PORT="8787"

# Optionele build-time sitemapbron. Laat leeg voor alleen statische routes.
SITEMAP_SOURCE_URL=""
SITEMAP_SOURCE_TOKEN=""

# Bewust niet actief: Stripe/Peecho, fysieke bestellingen, payment- en
# printproofworkers, e-mailproviders, AI-providers, wachtwoorden en magic links.
# Historische compatibiliteitscode blijft dormant bij CHECKOUT_MODE=off.
