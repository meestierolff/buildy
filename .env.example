# Canonieke feedback-beta omgeving voor Buildy.
# Kopieer alleen naar een lokaal, niet-getrackt .env-bestand.
# Commit nooit secrets, tokens, signed URL's of persoonsgegevens.

NODE_ENV="development"
APP_ENV="local" # local | test | preview | staging | production
APP_ORIGIN="http://127.0.0.1:8080"
PRIMARY_DOMAIN=""
TRUSTED_ORIGINS=""

# Eén server-owned productprofiel.
PRODUCT_PROFILE="feedback_beta"
CHECKOUT_MODE="off"

# Publieke browserconfig.
VITE_SITE_URL="https://buildy.example"

# Neon PostgreSQL.
DATABASE_URL=""
DATABASE_MIGRATION_URL=""

# Sessies en privacygevoelige serverfuncties.
SESSION_SECRET=""
PII_ENCRYPTION_KEYS='{"1":"<32-byte-base64-key>"}'
PII_ENCRYPTION_CURRENT_VERSION="1"
PII_BLIND_INDEX_KEY=""

# Google OpenID Connect.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Private Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# Minimale product- en operatorconfig.
SUPPORT_EMAIL="support@example.test"
FOUNDER_ADMIN_GOOGLE_SUB=""
ACCOUNT_RETENTION_POLICY_VERSION=""
ACCOUNT_RETENTION_POLICY_APPROVED_AT=""

# Lokale server.
BUILDY_API_HOST="127.0.0.1"
BUILDY_API_PORT="8787"

# Opzettelijk niet opgenomen in het feedback-beta-profiel:
# - Better Auth
# - wachtwoord- en e-mailauth
# - Brevo
# - Cloudflare R2 / AWS S3
# - Stripe
# - Peecho
# - frequente cron- of workerconfiguratie
