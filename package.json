{
  "name": "buildy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/local.ts",
    "build": "vite build && node scripts/generate-sitemap.mjs --output-dir dist",
    "build:dev": "vite build --mode development && node scripts/generate-sitemap.mjs --output-dir dist",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bunx playwright test",
    "test:e2e:preview": "PLAYWRIGHT_MODE=preview bunx playwright test",
    "test:regression": "bun run build && PLAYWRIGHT_MODE=preview bunx playwright test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "audit:private-assets": "node scripts/inventory-private-assets.mjs",
    "audit:social": "node scripts/audit-social-integrity.mjs",
    "moderation:role": "node --import tsx scripts/moderation/manage-role.ts",
    "email:previews": "node --import tsx scripts/email/generate-previews.ts",
    "setup:providers": "node --import tsx scripts/setup/providers.ts",
    "beta:invites": "node --import tsx scripts/beta/manage-invites.ts",
    "migration:check": "node --import tsx scripts/migration/buildy-migrate.ts preflight",
    "migration:run": "node --import tsx scripts/migration/buildy-migrate.ts",
    "migration:typecheck": "tsc -p tsconfig.migration.json --noEmit",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:check": "tsx db/migrate.ts --check",
    "db:migrate:dry": "tsx db/migrate.ts --dry-run",
    "db:verify": "tsx db/verify.ts",
    "test:db-runner": "vitest run tests/db"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "stripe": "^22.4.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "3.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "brace-expansion": "1.1.18",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "flatted": "3.4.4",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
